{
  "hosting": {
    "public": "app",
    "ignore": ["firebase.json", "**/.*", "eval-set.json"],
    "headers": [{ "source": "**/*.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "remoteconfig": {
    "template": "remoteconfig.template.json"
  }
}
